# Get a free key at https://aistudio.google.com/apikey. With it, Gemini scores every resume; without it, a keyword scorer is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# EASIEST: Gmail. Turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative to Gmail: Resend. Emails the 2-minute reset code (https://resend.com). Without it the code prints only in the server console.
RESEND_API_KEY=
MAIL_FROM=
# Comma-separated emails allowed to open admin routes (/users, /mongodb, /sqlite)
ADMIN_EMAILS=
PORT=3000
